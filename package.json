{
  "name": "real-estate-review-with-harness",
  "private": true,
  "version": "0.1.0",
  "packageManager": "bun@1.2.8",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev --parallel",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "db:generate": "turbo db:generate --filter=@repo/api",
    "db:migrate": "turbo db:migrate --filter=@repo/api",
    "db:reset": "bun run --cwd apps/api db:reset"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/node": "^22.15.0",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "eslint": "^9.25.1",
    "eslint-plugin-import": "^2.32.0",
    "prettier": "^3.9.6",
    "stylelint": "^17.14.1",
    "stylelint-declaration-strict-value": "^1.11.1",
    "turbo": "^2.5.1",
    "typescript": "^5.8.3"
  }
}
