# 루트 .env 하나를 단일 진실공급원으로 쓴다.
# api: bun --env-file=../../.env / web: 같은 방식으로 next 에 주입.
# 새 변수는 packages/env/src/index.ts 스키마와 이 파일에 동시에 추가한다.

NODE_ENV=development

# --- DB ---
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# 원본 저장소(real-estate-agent-review)가 5432를 쓰므로 충돌을 피해 5433을 기본으로 한다
POSTGRES_PORT=5433
DATABASE_URL=postgres://postgres:postgres@localhost:5433/app

# --- API ---
# 원본 저장소가 8787/3000 을 쓰므로 충돌을 피해 8788/3001 을 쓴다 (docs/decisions.md #6)
API_PORT=8788

# --- WEB ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8788
# 카카오 지도 JS SDK 키. 브라우저 번들에 inline 되므로 콘솔에서 도메인 제한을 걸 것
NEXT_PUBLIC_KAKAO_JS_KEY=

# --- 시딩 전용 (API 서버 부팅에는 불필요) ---
# 경기데이터드림 OpenAPI — 중개업소 원천 목록
GYEONGGI_API_KEY=
GYEONGGI_API_BASE_URL=https://openapi.gg.go.kr
# 카카오 REST 키 — 주소 → 좌표 지오코딩. 서버 밖으로 나가지 않는다
KAKAO_REST_API_KEY=
SEED_TARGET_SIGUNGU=성남시
